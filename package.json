{
  "name": "wowidle",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "WowIdle（工作名）—— 魔兽风公会会长放置模拟（仓库 RaidNight）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build --configLoader runner",
    "preview": "vite preview",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "gen:art": "vite-node --configLoader runner scripts/gen-art.ts",
    "gen:icon": "vite-node --configLoader runner scripts/gen-app-icon.ts",
    "sim:round": "vite-node --configLoader runner scripts/sim-round.ts",
    "gen:store": "vite-node --configLoader runner scripts/gen-store-art.ts",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "android/gradlew -p android assembleDebug",
    "sim:dump": "vite-node --configLoader runner scripts/dump-save.ts"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^26.6.5",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
